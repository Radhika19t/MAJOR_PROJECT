<% layout("/layouts/boilerplate") %>

    <div class="row mt-4">

        <div class="col-8 offset-2">

            <div class="card shadow">

                <img src="<%= listing.image.url %>" class="card-img-top" style="height: 25rem; object-fit: cover;"
                    alt="Listing Image">

                <div class="card-body">

                    <h2 class="card-title">
                        <%= listing.title %>
                    </h2>
                    <p class="text-muted">
                        Posted by <%= listing.owner ? listing.owner.username : "Unknown User" %>
                    </p>
                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <hr>

                    <p>
                        <strong>💰 Price:</strong>
                        ₹ <%= listing.price.toLocaleString("en-IN") %>
                    </p>

                    <p>
                        <strong>📍 Location:</strong>
                        <%= listing.location %>
                    </p>

                    <p>
                        <strong>🌍 Country:</strong>
                        <%= listing.country %>
                    </p>

                    <div class="mt-4">

                        <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>

                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning me-2">
                                Edit
                            </a>

                            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">

                                <button class="btn btn-danger">
                                    Delete
                                </button>

                            </form>

                            <% } %>
                                <hr>

                                <h4>Add Review</h4>

                                <form action="/listings/<%= listing._id %>/reviews" method="POST">

                                    <div class="mb-3">
                                        <label class="form-label">Rating</label>

                                        <input type="range" min="1" max="5" class="form-range" name="review[rating]">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Comment</label>

                                        <textarea name="review[comment]" class="form-control" required></textarea>
                                    </div>

                                    <button class="btn btn-dark">
                                        Submit Review
                                    </button>

                                </form>
                                <hr>
                                <h3 class="mt-5">All Reviews</h3>

                                <div class="row">

                                    <% for(let review of listing.reviews){ %>

                                        <div class="col-md-6">

                                            <div class="card mb-3 shadow-sm">

                                                <div class="card-body">

                                                    <h6 class="card-subtitle mb-2 text-muted">
                                                        <%= review.author.username %>
                                                    </h6>

                                                    <h5>
                                                        ⭐ <%= review.rating %> / 5
                                                    </h5>

                                                    <p class="card-text">
                                                        <%= review.comment %>
                                                    </p>

                                                    <% if(currUser && review.author._id.equals(currUser._id)){ %>

                                                        <form
                                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                            method="POST">

                                                            <button class="btn btn-sm btn-danger">
                                                                Delete
                                                            </button>

                                                        </form>

                                                        <% } %>

                                                </div>

                                            </div>

                                        </div>

                                        <% } %>

                                </div>


                    </div>

                </div>

            </div>

        </div>

    </div>

    </div>